      "item": [
        {
          "name": "Get own consultant before CV completion",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/medewerkers/medewerker?id={{consultantId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "medewerkers",
                "medewerker"
              ],
              "query": [
                {
                  "key": "id",
                  "value": "{{consultantId}}"
                }
              ]
            }
          }
        },
        {
          "name": "Complete one-time CV",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/medewerkers/curriculumVitae/eersteLogin",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "medewerkers",
                "curriculumVitae",
                "eersteLogin"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id\": null,\n  \"bestandsNaam\": \"cv_ada_lovelace\",\n  \"competenties\": [\n    \"Java\",\n    \"Spring Boot\",\n    \"API testing\"\n  ],\n  \"languages\": {\n    \"Dutch\": \"Native\",\n    \"English\": \"Professional\"\n  },\n  \"profiel\": \"Experienced software consultant.\",\n  \"opleiding\": \"Computer Science\",\n  \"matrix\": null,\n  \"ervaring\": []\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('one-time CV completed', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "const body = pm.response.json();",
                  "pm.collectionVariables.set('completedConsultant', JSON.stringify(body));",
                  "if (body.orgineleCv && body.orgineleCv.id) {",
                  "  pm.collectionVariables.set('cvId', body.orgineleCv.id);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Update own consultant record",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/medewerkers/updateMedewerker",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "medewerkers",
                "updateMedewerker"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{{completedConsultant}}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('consultant update succeeded before account is disabled', function () {",
                  "  pm.response.to.have.status(200);",
                  "});"
